pipeline {
agent any


environment {
    SSH_CRED = 'node-app-key'
    SERVER_IP = '34.228.32.98'
    REMOTE_USER = 'ubuntu'
    WEB_DIR = '/var/www/html/'
}

stages {

    stage('Clone Repository') {
        steps {
            git url: 'https://github.com/AmeyDatir/Amey-Portfolio.git', branch: 'main'
        }
    }

    stage('Deploy to Apache Server') {
        steps {
            sshagent(credentials: ["${SSH_CRED}"]) {
                sh '''
                    echo "Cleaning old files on server..."
                    ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${SERVER_IP} "sudo rm -rf ${WEB_DIR}/*"

                    echo "Uploading files to server..."
                    scp -o StrictHostKeyChecking=no index.html script.js style.css ${REMOTE_USER}@${SERVER_IP}:/tmp/

                    echo "Deploying files to Apache directory..."
                    ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${SERVER_IP} "sudo cp /tmp/index.html /tmp/script.js /tmp/style.css ${WEB_DIR}/"

                    echo "Deployment Successful"
                '''
            }
        }
    }

}



